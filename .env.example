# ==========================================
# 1. 协议选择
# ==========================================
# 支持: openai (或 responses) / anthropic (或 claude)
AI_PROTOCOL=openai

# ==========================================
# 2. 官方标准环境变量
# ==========================================
# Anthropic / Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI / DeepSeek
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com

# ==========================================
# 3. 自定义功能环境变量 (自定义中转 / OneAPI / 内网网关)
# ==========================================
# 自定义鉴权密钥 (未配置官方 KEY 时自动回退至此)
CUSTOM_API_KEY=
# 自定义 Base URL (兼容 AI_BASE_URL)
CUSTOM_BASE_URL=
# 显式直连端点 (若配置则直接使用完整 URL，跳过协议默认拼接)
# CUSTOM_ENDPOINT=https://your-proxy.com/v1/messages
# 自定义模型名称 (优先级高于 MODEL_NAME)
CUSTOM_MODEL=
# 自定义系统指令 (留空则使用内置 2026 Agentic Engineer 系统提示词)
# CUSTOM_SYSTEM_PROMPT=
# 自定义 HTTP Headers (支持逗号分隔 "K1:V1,K2:V2" 或 JSON 字符串 '{"X-Gateway-Auth":"xxx"}')
# CUSTOM_HEADERS=
# 自定义采样参数 (可选)
# CUSTOM_TEMPERATURE=1.0
# CUSTOM_TOP_P=1.0

# ==========================================
# 4. 通用模型运行配置
# ==========================================
MODEL_NAME=deepseek-v4-flash-vision-exp
REASONING_EFFORT=medium
MAX_OUTPUT_TOKENS=8192
MAX_RETRIES=3

# 联网搜索开关 (true / false)
ENABLE_WEB_SEARCH=true
