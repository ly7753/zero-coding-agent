# ==========================================
# 1. 协议选择与官方凭证
# ==========================================
# 协议选择：openai (或 responses) / anthropic (或 claude)
# 注：已将非标准的 AI_PROTOCOL 统一为标准 PROTOCOL
PROTOCOL=openai

# OpenAI 官方标准配置（用于 Responses 协议）
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com

# Anthropic 官方标准配置（用于 Messages 协议）
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ==========================================
# 2. 模型核心配置与思考预算
# ==========================================
# 模型名（例如：gpt-4o、o3-mini、claude-3-7-sonnet-20250219、claude-opus-5 等）
MODEL_NAME=gpt-4o

# OpenAI o系列模型思考强度（low / medium / high）
REASONING_EFFORT=medium

# Anthropic Claude 思考深度动态预算（整数，≥1024，≤ MAX_OUTPUT_TOKENS 的 80%）
ANTHROPIC_THINKING_BUDGET=16000
# 是否禁用 Claude 思维链（true / false）
ANTHROPIC_DISABLE_THINKING=false

# 单次最大输出 Token 数与网络容错
MAX_OUTPUT_TOKENS=64000
MAX_RETRIES=3

# Responses 协议原生联网搜索组件开关（true / false）
ENABLE_WEB_SEARCH=true

# ==========================================
# 3. 内置功能：图片压缩（read_image 工具）
# ==========================================
# 最长边像素限制，超出则自动等比缩小以节省视觉 Token（默认 1600）
IMAGE_MAX_DIM=1600

# JPEG 压缩质量（1-100，默认 82）
IMAGE_JPEG_QUALITY=82

# ==========================================
# 4. 内置功能：文本结构化输出（仅 Responses 协议）
# ==========================================
# 约束输出模式：json_object 或 json_schema
# TEXT_FORMAT=json_object

# 当使用 json_schema 时的自定义约束定义
# TEXT_SCHEMA_NAME=my_schema
# TEXT_SCHEMA={"type":"object","properties":{"summary":{"type":"string"}},"required":["summary"]}

# ==========================================
# 5. 内置功能：用户标识与采样对数概率（可选）
# ==========================================
# 终端用户安全审计与跟踪标识
# USER_ID=user_prod_123

# 对数概率采样维度（1~20）
# TOP_LOGPROBS=5

# ==========================================
# 6. 底层系统终端（Windows 环境专用）
# ==========================================
# 指定命令执行工具：powershell 或 cmd（默认 powershell）
# SHELL=powershell

# ===== 上下文压缩（Context Compaction）=====
COMPACTION_ENABLED=true
COMPACTION_TRIGGER=0.85
COMPACTION_KEEP_RECENT=5

COMPACTION_MODEL=gpt-4o
MAX_CONTEXT_TOKENS=128000

# ===== Grep增强（可选额外忽略）=====
GREP_EXTRA_IGNORE=*.pb,*.pyc,*.o