# ==============================================================================
# zero-coding-agent 环境变量配置模板
# 复制本文件为 .env 并填写实际参数: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 核心 API 凭据与服务端点 (必填)
# ------------------------------------------------------------------------------
# API 密钥 (支持 OPENAI_API_KEY 或 AI_API_KEY)
OPENAI_API_KEY=sk-your-api-key-here
# AI_API_KEY=sk-your-api-key-here

# 服务端点 Base URL (默认: https://api.deepseek.com)
# 支持 OPENAI_BASE_URL 或 AI_BASE_URL
OPENAI_BASE_URL=https://api.deepseek.com
# AI_BASE_URL=https://api.deepseek.com

# 通信协议协议: responses (默认，原生 Responses API) 或 anthropic (Claude Messages 兼容 API)
# 可在运行期间通过 /protocol 命令实时切换
AI_PROTOCOL=responses

# 模型名称 (支持 MODEL_NAME 或 AI_MODEL，默认: deepseek-v4-flash-vision-exp)
MODEL_NAME=deepseek-v4-flash-vision-exp
# AI_MODEL=deepseek-v4-flash-vision-exp

# ------------------------------------------------------------------------------
# 2. 推理与生成参数 (可选)
# ------------------------------------------------------------------------------
# 思考推理力度: low / medium / high (仅在 Responses 协议且模型支持时生效，默认: medium)
REASONING_EFFORT=medium

# 单次请求最大生成 Token 数 (默认: 8192)
MAX_OUTPUT_TOKENS=8192

# 结构化输出格式 (可选: 设为 json_object 可启用强制 JSON 输出模式)
# TEXT_FORMAT=json_object

# 上下文采样的 Top Logprobs (可选: 1 ~ 20)
# TOP_LOGPROBS=5

# 终端用户唯一标识符 (可选: 用于审计或个性化上下文追踪)
# USER_ID=agent-user-001

# ------------------------------------------------------------------------------
# 3. 运行机制与工具能力 (可选)
# ------------------------------------------------------------------------------
# 网络与限流异常自动重试次数 (默认: 3)
MAX_RETRIES=3

# 是否启用原生联网检索 (true / false，默认: true)
# 可在运行期间通过 /web 命令实时切换
ENABLE_WEB_SEARCH=true

# Windows 下 exec_command 的命令宿主环境 (仅 Windows 生效，可选: powershell / cmd，默认: powershell)
# SHELL=powershell
