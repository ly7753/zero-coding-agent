# ==========================================
# 1. 协议选择与官方凭证
# ==========================================
# 协议选择：openai (或 responses) / anthropic (或 claude)
AI_PROTOCOL=openai
# Anthropic / Claude 官方标准环境变量
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
# OpenAI / DeepSeek 官方标准环境变量
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
# ==========================================
# 2. 模型核心配置
# ==========================================
MODEL_NAME=deepseek-v4-flash-vision-exp
REASONING_EFFORT=medium
MAX_OUTPUT_TOKENS=64000
MAX_RETRIES=3
ENABLE_WEB_SEARCH=true
# ==========================================
# 3. 内置功能：图片压缩（read_image 工具）
# ==========================================
# 最长边像素，超过则等比缩放。越小越省 token。
IMAGE_MAX_DIM=1600
# JPEG 压缩质量 1-100。越小体积越小。
IMAGE_JPEG_QUALITY=82
# ==========================================
# 4. 内置功能：文本输出格式（可选）
# ==========================================
# TEXT_FORMAT=json_object
# TEXT_SCHEMA_NAME=my_schema
# TEXT_SCHEMA={"type":"object","properties":{"summary":{"type":"string"}},"required":["summary"]}
# ==========================================
# 5. 内置功能：用户标识 / 输出概率 Top-N（可选）
# ==========================================
# USER_ID=my_user
# TOP_LOGPROBS=5
# ==========================================
# 6. 底层配置（Windows 执行终端）
# ==========================================
# SHELL=powershell
