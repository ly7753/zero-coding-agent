# ==========================================
# 1. Rust 构建与分析产物
# ==========================================
/target/
*.pdb
*.dSYM/

# 代码覆盖率与性能分析
coverage/
*.lcov
lcov.info
tarpaulin-report.*
flamegraph.svg
perf.data*

# ==========================================
# 2. 备份与临时还原文件
# ==========================================
*.bak
*.backup
*.old
*.orig
**/*.rs.bk
*~

# ==========================================
# 3. Cargo 依赖锁定文件 (Cargo.lock)
# ==========================================
# Web 服务 / CLI / 独立程序：保持注释（必须提交 Cargo.lock）
# 开源通用库（Library）：若需忽略可取消下一行的注释
# Cargo.lock

# ==========================================
# 4. 环境变量与凭证密钥
# ==========================================
.env
.env.*
!.env.example
!.env.template

# 私钥与证书
*.pem
*.key
*.cert
*.crt
*.pfx
*.keystore

# ==========================================
# 5. 会话、日志与运行时数据持久化
# ==========================================
sessions/
logs/
*.log
*.pid
*.sock

# 本地数据库与临时数据
*.sqlite
*.sqlite3
*.db
*.rdb
tmp/
temp/
uploads/
storage/

# ==========================================
# 6. 前端 / WASM / 全栈扩展（可选）
# ==========================================
node_modules/
dist/
pkg/
src-tauri/target/

# ==========================================
# 7. IDE 与编辑器配置
# ==========================================
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo

# ==========================================
